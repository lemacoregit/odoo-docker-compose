<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="template_demo_error" name="Demo Access Error">
        <t t-call="web.layout">
            <t t-set="head_website">
                <style>
                    body { background: #f4f5f7; }
                    .demo-error-wrap {
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                        padding: 2rem;
                    }
                    .demo-error-card {
                        background: #fff;
                        border-radius: 12px;
                        padding: 3rem;
                        max-width: 480px;
                        width: 100%;
                        box-shadow: 0 2px 16px rgba(0,0,0,0.08);
                        text-align: center;
                    }
                    .demo-error-icon {
                        font-size: 3rem;
                        margin-bottom: 1.5rem;
                        color: #e74c3c;
                    }
                    .demo-error-card h2 {
                        font-size: 1.4rem;
                        font-weight: 600;
                        color: #2c3e50;
                        margin-bottom: 1rem;
                    }
                    .demo-error-card p {
                        color: #666;
                        line-height: 1.6;
                        margin-bottom: 2rem;
                    }
                    .btn-back {
                        display: inline-block;
                        padding: 0.75rem 2rem;
                        background: #875A7B;
                        color: #fff;
                        border-radius: 6px;
                        text-decoration: none;
                        font-weight: 500;
                    }
                    .btn-back:hover { background: #6b4763; color: #fff; }
                </style>
            </t>
            <div class="demo-error-wrap">
                <div class="demo-error-card">
                    <div class="demo-error-icon">&#9888;</div>
                    <h2><t t-esc="error_title"/></h2>
                    <p><t t-esc="error_message"/></p>
                    <a href="https://lemacore.com" class="btn-back">
                        Back to Lemacore
                    </a>
                </div>
            </div>
        </t>
    </template>


    <template id="template_blocked_page" name="Blocked Page">
        <t t-call="web.layout">
            <t t-set="head_website">
                <style>
                    * { box-sizing: border-box; margin: 0; padding: 0; }
                    body { background: #f4f5f7; font-family: sans-serif; }
                    .blocked-wrap {
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                        padding: 2rem;
                    }
                    .blocked-card {
                        background: #fff;
                        border-radius: 12px;
                        padding: 3rem 2.5rem;
                        max-width: 480px;
                        width: 100%;
                        box-shadow: 0 2px 16px rgba(0,0,0,0.08);
                        text-align: center;
                    }
                    .blocked-logo {
                        margin-bottom: 1.5rem;
                    }
                    .blocked-logo img {
                        height: 48px;
                    }
                    .blocked-icon {
                        font-size: 3rem;
                        margin-bottom: 1rem;
                    }
                    .blocked-card h2 {
                        font-size: 1.4rem;
                        font-weight: 600;
                        color: #2c3e50;
                        margin-bottom: 0.75rem;
                    }
                    .blocked-card p {
                        color: #666;
                        line-height: 1.6;
                        margin-bottom: 2rem;
                    }
                    .btn-primary {
                        display: inline-block;
                        padding: 0.75rem 2rem;
                        background: #875A7B;
                        color: #fff;
                        border-radius: 6px;
                        text-decoration: none;
                        font-weight: 500;
                        transition: background 0.2s;
                    }
                    .btn-primary:hover { background: #6b4763; color: #fff; }
                    .divider {
                        border: none;
                        border-top: 1px solid #eee;
                        margin: 1.5rem 0;
                    }
                    .note {
                        font-size: 0.85rem;
                        color: #999;
                    }
                </style>
            </t>
            <div class="blocked-wrap">
                <div class="blocked-card">
                    <div class="blocked-icon">&#128274;</div>
                    <h2>This Page Is Not Available</h2>
                    <p>
                        Access to the database manager is not permitted.<br/>
                        If you'd like to try our product demo, please visit our website.
                    </p>
                    <a href="https://lemacore.com" class="btn-primary" target="_blank">
                        Visit Lemacore.com
                    </a>
                    <hr class="divider"/>
                    <p class="note">
                        Already have a demo link? Use the link provided by our team to sign in directly.
                    </p>
                </div>
            </div>
        </t>
    </template>

</odoo>
