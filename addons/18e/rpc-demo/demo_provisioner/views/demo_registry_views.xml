<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="view_demo_registry_form" model="ir.ui.view">
        <field name="name">demo.registry.form</field>
        <field name="model">demo.registry</field>
        <field name="arch" type="xml">
            <form string="Demo Registry">
                <header>
                    <button name="button_provision"
                            type="object"
                            string="Provision Demo"
                            class="btn-primary"
                            invisible="state in ('active','provisioning','deactivated')"
                            confirm="This will create a new database and install the module. Continue?"/>
                    <button name="button_reset"
                            type="object"
                            string="Reset Demo"
                            invisible="state not in ('active','deactivated')"
                            confirm="The database will be reset to its initial state. Current demo data will be lost. Continue?"/>
                    <button name="button_regenerate_token"
                            type="object"
                            string="Regenerate Token"
                            invisible="state not in ('active','deactivated')"/>
                    <button name="button_archive_demo"
                            type="object"
                            string="Deactivate"
                            class="btn-danger"
                            invisible="state not in ('active','error')"
                            confirm="The demo database will be permanently deleted. Are you sure?"/>
                    <button name="button_set_to_draft"
                            type="object"
                            string="Set to Draft"
                            invisible="state not in ('deactivated','error')"/>
                    <button name="button_force_cancel"
                            type="object"
                            string="Force Cancel"
                            class="btn-warning"
                            invisible="state not in ('provisioning','error')"
                            confirm="This will cancel the provisioning and drop any partial database. Reset to Draft?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,deactivated"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g.: Lemacore Sales Demo"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Module Configuration">
                            <field name="server_id"
                                   readonly="state in ('active','provisioning','deactivated')"
                                   options="{'no_create': True}"/>
                            <field name="module_name"
                                   placeholder="lemacore_sale"
                                   readonly="state in ('active','provisioning','deactivated')"/>
                            <field name="extra_modules"
                                   placeholder="sale,purchase,stock (optional)"
                                   readonly="state in ('active','provisioning','deactivated')"/>
                            <field name="db_name"/>
                        </group>
                        <group string="Demo Access">
                            <field name="demo_user_login"/>
                            <field name="demo_user_password" password="True"/>
                            <field name="token_expiry_days"/>
                            <field name="demo_url"
                                   widget="url"
                                   invisible="not demo_url"/>
                            <field name="token_expiry"
                                   invisible="not token_expiry"/>
                            <field name="last_reset"
                                   invisible="not last_reset"/>
                        </group>
                    </group>

                    <group string="Server Configuration">
                        <field name="custom_addons_path"
                               placeholder="/mnt/lema-demo18/addons/apps1,/mnt/lema-demo18/addons/apps2"
                               readonly="state in ('active','provisioning','deactivated')"/>
                        <field name="base_demo_url"
                               placeholder="https://demo.lemacore.com"
                               readonly="state in ('active','provisioning','deactivated')"/>
                        <field name="demo_xmlrpc_url"
                               placeholder="http://odoo18-lema-demo:8069"
                               readonly="state in ('active','provisioning','deactivated')"/>
                    </group>

                    <group string="Administrator Credentials">
                        <field name="demo_admin_login"/>
                        <field name="demo_admin_password" password="True"/>
                    </group>

                    <!-- URL Box highlighted when active -->
                    <div invisible="state != 'active'"
                         class="alert alert-success">
                        <strong>Demo URL Ready:</strong>
                        <field name="demo_url" widget="url" nolabel="1"/>
                        <p class="mb-0 text-muted">
                            Share this URL with the client. One click and they are logged in without any manual login.
                        </p>
                    </div>

                    <div invisible="state != 'deactivated'"
                         class="alert alert-warning">
                        <strong>Demo Deactivated.</strong>
                        Token has expired and the demo URL is no longer accessible.
                        Use <b>Reset Demo</b> to restore the database and generate a new token,
                        or <b>Regenerate Token</b> to reactivate without resetting data.
                    </div>

                    <div invisible="state != 'error'"
                         class="alert alert-danger">
                        <strong>Provisioning failed.</strong>
                        Check the log below for error details.
                    </div>

                    <notebook>
                        <page string="Provisioning Log" name="log">
                            <field name="provision_log"
                                   widget="text"
                                   readonly="1"
                                   nolabel="1"
                                   style="font-family: monospace; font-size: 12px; min-height: 200px;"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Add notes about this demo..."/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="view_demo_registry_list" model="ir.ui.view">
        <field name="name">demo.registry.list</field>
        <field name="model">demo.registry</field>
        <field name="arch" type="xml">
            <list string="Demo Registry" decoration-muted="state == 'deactivated'"
                  decoration-danger="state == 'error'"
                  decoration-success="state == 'active'">
                <field name="name"/>
                <field name="server_id" optional="show"/>
                <field name="module_name"/>
                <field name="db_name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state in ('provisioning','deactivated')"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'draft'"/>
                <field name="token_expiry" optional="show"/>
                <field name="demo_url" widget="url" optional="show"/>
                <field name="last_reset" optional="show"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────────────────────── -->
    <record id="view_demo_registry_search" model="ir.ui.view">
        <field name="name">demo.registry.search</field>
        <field name="model">demo.registry</field>
        <field name="arch" type="xml">
            <search string="Search Demo">
                <field name="name"/>
                <field name="module_name"/>
                <separator/>
                <filter string="Active" name="active"
                        domain="[('state','=','active')]"/>
                <filter string="Draft" name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Error" name="error"
                        domain="[('state','=','error')]"/>
                <filter string="Deactivated" name="deactivated"
                        domain="[('state','=','deactivated')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────────── -->
    <record id="action_demo_registry" model="ir.actions.act_window">
        <field name="name">Demo Registry</field>
        <field name="res_model">demo.registry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_demo_registry_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No demos registered yet.
            </p>
            <p>
                Click <b>New</b> to add a custom module and automatically
                provision its demo database.
            </p>
        </field>
    </record>

</odoo>
