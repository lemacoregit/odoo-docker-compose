<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="view_demo_server_form" model="ir.ui.view">
        <field name="name">demo.server.form</field>
        <field name="model">demo.server</field>
        <field name="arch" type="xml">
            <form string="Demo Server">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_registries"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list"
                                invisible="registry_count == 0">
                            <field name="registry_count" widget="statinfo" string="Demos"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g.: Odoo 18 Demo Server"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Server Identity">
                            <field name="odoo_version" placeholder="18.0"/>
                            <field name="container_name" placeholder="odoo-demo18e"/>
                            <field name="odoo_conf" placeholder="/etc/odoo/odoo.conf"/>
                            <field name="db_name_prefix" placeholder="lema_demo18e"/>
                        </group>
                        <group string="Network">
                            <field name="base_demo_url" placeholder="https://demo.lemacore.com"/>
                            <field name="demo_xmlrpc_url" placeholder="http://odoo-demo18e:8069"/>
                        </group>
                    </group>

                    <group string="Default Addons Path">
                        <field name="custom_addons_path" nolabel="1"
                               placeholder="/mnt/lema-demo18/addons/apps1,/mnt/lema-demo18/addons/apps2"/>
                    </group>

                    <group string="Backup Settings">
                        <field name="filestore_base"
                               placeholder="/var/lib/odoo/filestore"/>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Any notes about this server configuration..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="view_demo_server_list" model="ir.ui.view">
        <field name="name">demo.server.list</field>
        <field name="model">demo.server</field>
        <field name="arch" type="xml">
            <list string="Demo Servers">
                <field name="name"/>
                <field name="odoo_version"/>
                <field name="container_name"/>
                <field name="db_name_prefix"/>
                <field name="base_demo_url"/>
                <field name="demo_xmlrpc_url" optional="hide"/>
                <field name="custom_addons_path" optional="hide"/>
                <field name="registry_count" string="Demos"/>
            </list>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────────── -->
    <record id="action_demo_server" model="ir.actions.act_window">
        <field name="name">Demo Servers</field>
        <field name="res_model">demo.server</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No demo servers configured yet.
            </p>
            <p>
                Add a server to define the Docker container and URLs
                for each Odoo version you want to provision demos on.
            </p>
        </field>
    </record>

</odoo>
