<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="res_config_edition" t-inherit-mode="extension" owl="1">
        <xpath expr="//h3" position="replace">

        </xpath>
        <xpath expr="//div[hasclass('tab-content')]" position="replace">
            <div class="tab-content">
                <div role="tabpanel" id="settings" class="tab-pane active text-muted o_web_settings_compact_subtitle">
                    <small>Copyright © 2026 Lema Core Technologies</small>
                </div>
            </div>
        </xpath>
        <xpath expr="//*[@t-if='expirationDate']" position="replace">
            <h5>This is an open version and has no expiration date.</h5>
        </xpath>
    </t>
</templates>